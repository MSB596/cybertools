<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MSB Fisika Ultimate</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Share Tech Mono', monospace; }
  body { background-color: #0a0000; color: #ffffff; padding: 20px; min-height: 100vh;
    background-image: linear-gradient(rgba(239,68,68,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(239,68,68,0.05) 1px, transparent 1px);
    background-size: 20px 20px; }
  .container { max-width: 700px; margin: auto; }
  h1 { text-align: center; font-size: 24px; color: #ef4444; text-shadow: 0 0 10px rgba(239,68,68,0.5); margin-bottom: 5px; }
  .subtitle { text-align: center; font-size: 11px; color: #884444; margin-bottom: 20px; letter-spacing: 1px;}
  
  /* SEARCH BAR */
  .search-box { width: 100%; padding: 15px; background: rgba(0,0,0,0.6); border: 1px solid #ef4444; color: #fff; font-size: 14px; margin-bottom: 20px; outline: none; border-radius: 4px;}
  .search-box:focus { box-shadow: 0 0 10px rgba(239,68,68,0.5); }

  .tool-card { background: rgba(20,0,0,0.8); border: 1px solid #3f1d1d; padding: 20px; margin-bottom: 15px; border-left: 4px solid #ef4444; display: none; animation: fadeIn 0.3s ease;}
  .tool-card.active { display: block; }
  .tool-card h2 { font-size: 14px; color: #ef4444; margin-bottom: 15px; border-bottom: 1px dashed #3f1d1d; padding-bottom: 8px;}
  
  .input-group { margin-bottom: 12px; }
  label { font-size: 11px; color: #aa8888; display: block; margin-bottom: 5px; text-transform: uppercase;}
  input { width: 100%; padding: 12px; background: transparent; border: 1px solid #3f1d1d; color: #fff; font-size: 14px; }
  input:focus { outline: none; border-color: #ef4444; background: #1f0808;}
  button.hitung { width: 100%; background: #ef4444; color: #0a0000; border: none; padding: 12px; cursor: pointer; font-weight: bold; margin-top: 8px; font-size: 14px; transition: 0.2s;}
  button.hitung:hover { background: #ff6666; box-shadow: 0 0 15px rgba(239,68,68,0.4); }
  
  .hasil { background: rgba(0,0,0,0.6); padding: 12px; border-left: 2px solid #4ade80; margin-top: 15px; font-size: 14px; color: #4ade80; word-break: break-all; }
  .hasil.error { border-left-color: #ff0000; color: #ff0000; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
</head>
<body>
<div class="container">
  <h1>MSB FISIKA ULTIMATE</h1>
  <p class="subtitle">LENGKAP & CEPAT // CRIMSON EDITION</p>

  <input type="text" class="search-box" id="searchInput" placeholder="🔍 Cari rumus (misal: newton, listrik, energi)..." onkeyup="cariRumus()">

  <!-- 1. KECEPATAN -->
  <div class="tool-card active" data-nama="kecepatan kinematika jarak waktu">
    <h2>01 // KECEPATAN (v = s/t)</h2>
    <div class="input-group"><label>Jarak (s) [m]</label><input type="number" id="v-s"></div>
    <div class="input-group"><label>Waktu (t) [s]</label><input type="number" id="v-t"></div>
    <button class="hitung" onclick="hitungV()">HITUNG</button>
    <div class="hasil" id="out-v">> Standby...</div>
  </div>

  <!-- 2. PERCEPATAN -->
  <div class="tool-card active" data-nama="percepatan kinematika">
    <h2>02 // PERCEPATAN (a = Δv/t)</h2>
    <div class="input-group"><label>Kecepatan Akhir (v) [m/s]</label><input type="number" id="a-v"></div>
    <div class="input-group"><label>Kecepatan Awal (v₀) [m/s]</label><input type="number" id="a-v0"></div>
    <div class="input-group"><label>Waktu (t) [s]</label><input type="number" id="a-t"></div>
    <button class="hitung" onclick="hitungA()">HITUNG</button>
    <div class="hasil" id="out-a">> Standby...</div>
  </div>

  <!-- 3. GAYA NEWTON -->
  <div class="tool-card active" data-nama="gaya newton dinamika massa percepatan">
    <h2>03 // GAYA NEWTON (F = m · a)</h2>
    <div class="input-group"><label>Massa (m) [kg]</label><input type="number" id="f-m"></div>
    <div class="input-group"><label>Percepatan (a) [m/s²]</label><input type="number" id="f-a"></div>
    <button class="hitung" onclick="hitungF()">HITUNG</button>
    <div class="hasil" id="out-f">> Standby...</div>
  </div>

  <!-- 4. ENERGI KINETIK -->
  <div class="tool-card active" data-nama="energi kinetik gerak massa kecepatan">
    <h2>04 // ENERGI KINETIK (Ek = ½mv²)</h2>
    <div class="input-group"><label>Massa (m) [kg]</label><input type="number" id="ek-m"></div>
    <div class="input-group"><label>Kecepatan (v) [m/s]</label><input type="number" id="ek-v"></div>
    <button class="hitung" onclick="hitungEk()">HITUNG</button>
    <div class="hasil" id="out-ek">> Standby...</div>
  </div>

  <!-- 5. ENERGI POTENSIAL -->
  <div class="tool-card active" data-nama="energi potensial gravitasi ketinggian">
    <h2>05 // ENERGI POTENSIAL (Ep = mgh)</h2>
    <div class="input-group"><label>Massa (m) [kg]</label><input type="number" id="ep-m"></div>
    <div class="input-group"><label>Gravitasi (g) [m/s²]</label><input type="number" id="ep-g" value="9.8"></div>
    <div class="input-group"><label>Ketinggian (h) [m]</label><input type="number" id="ep-h"></div>
    <button class="hitung" onclick="hitungEp()">HITUNG</button>
    <div class="hasil" id="out-ep">> Standby...</div>
  </div>

  <!-- 6. USAHA -->
  <div class="tool-card active" data-nama="usaha kerja gaya jarak">
    <h2>06 // USAHA (W = F · s)</h2>
    <div class="input-group"><label>Gaya (F) [N]</label><input type="number" id="w-f"></div>
    <div class="input-group"><label>Jarak (s) [m]</label><input type="number" id="w-s"></div>
    <button class="hitung" onclick="hitungW()">HITUNG</button>
    <div class="hasil" id="out-w">> Standby...</div>
  </div>

  <!-- 7. DAYA -->
  <div class="tool-card active" data-nama="daya power waktu usaha">
    <h2>07 // DAYA (P = W/t)</h2>
    <div class="input-group"><label>Usaha (W) [J]</label><input type="number" id="p-w"></div>
    <div class="input-group"><label>Waktu (t) [s]</label><input type="number" id="p-t"></div>
    <button class="hitung" onclick="hitungP()">HITUNG</button>
    <div class="hasil" id="out-p">> Standby...</div>
  </div>

  <!-- 8. TEKANAN -->
  <div class="tool-card active" data-nama="tekanan pressure gaya luas">
    <h2>08 // TEKANAN (P = F/A)</h2>
    <div class="input-group"><label>Gaya (F) [N]</label><input type="number" id="pr-f"></div>
    <div class="input-group"><label>Luas (A) [m²]</label><input type="number" id="pr-a"></div>
    <button class="hitung" onclick="hitungPr()">HITUNG</button>
    <div class="hasil" id="out-pr">> Standby...</div>
  </div>

  <!-- 9. MASSA JENIS -->
  <div class="tool-card active" data-nama="massa jenis densitas fluida volume">
    <h2>09 // MASSA JENIS (ρ = m/V)</h2>
    <div class="input-group"><label>Massa (m) [kg]</label><input type="number" id="rho-m"></div>
    <div class="input-group"><label>Volume (V) [m³]</label><input type="number" id="rho-v"></div>
    <button class="hitung" onclick="hitungRho()">HITUNG</button>
    <div class="hasil" id="out-rho">> Standby...</div>
  </div>

  <!-- 10. KONVERSI SUHU -->
  <div class="tool-card active" data-nama="suhu suhu kalor termodinamika celcius">
    <h2>10 // KONVERSI SUHU (°C)</h2>
    <div class="input-group"><label>Celsius (°C)</label><input type="number" id="suhu-c"></div>
    <button class="hitung" onclick="konversiSuhu()">HITUNG</button>
    <div class="hasil" id="out-suhu">> Standby...</div>
  </div>

  <!-- 11. KALOR -->
  <div class="tool-card active" data-nama="kalor panas suhu massa kalor jenis">
    <h2>11 // KALOR (Q = m · c · ΔT)</h2>
    <div class="input-group"><label>Massa (m) [kg]</label><input type="number" id="q-m"></div>
    <div class="input-group"><label>Kalor Jenis (c) [J/kg°C]</label><input type="number" id="q-c"></div>
    <div class="input-group"><label>Perubahan Suhu (ΔT) [°C]</label><input type="number" id="q-dt"></div>
    <button class="hitung" onclick="hitungQ()">HITUNG</button>
    <div class="hasil" id="out-q">> Standby...</div>
  </div>

  <!-- 12. HUKUM OHM -->
  <div class="tool-card active" data-nama="ohm listrik tegangan hambatan arus">
    <h2>12 // HUKUM OHM (V = I · R)</h2>
    <div class="input-group"><label>Arus (I) [Ampere]</label><input type="number" id="ohm-i"></div>
    <div class="input-group"><label>Hambatan (R) [Ohm]</label><input type="number" id="ohm-r"></div>
    <button class="hitung" onclick="hitungOhm()">HITUNG</button>
    <div class="hasil" id="out-ohm">> Standby...</div>
  </div>

  <!-- 13. DAYA LISTRIK -->
  <div class="tool-card active" data-nama="daya listrik watt tegangan arus">
    <h2>13 // DAYA LISTRIK (P = V · I)</h2>
    <div class="input-group"><label>Tegangan (V) [Volt]</label><input type="number" id="pl-v"></div>
    <div class="input-group"><label>Arus (I) [Ampere]</label><input type="number" id="pl-i"></div>
    <button class="hitung" onclick="hitungPl()">HITUNG</button>
    <div class="hasil" id="out-pl">> Standby...</div>
  </div>

  <!-- 14. GELOMBANG -->
  <div class="tool-card active" data-nama="gelombang frekuensi panjang gelombang cepat rambat">
    <h2>14 // CEPAT RAMBAT GELOMBANG (v = λ · f)</h2>
    <div class="input-group"><label>Panjang Gelombang (λ) [m]</label><input type="number" id="gel-l"></div>
    <div class="input-group"><label>Frekuensi (f) [Hz]</label><input type="number" id="gel-f"></div>
    <button class="hitung" onclick="hitungGel()">HITUNG</button>
    <div class="hasil" id="out-gel">> Standby...</div>
  </div>

  <!-- 15. MOMENTUM -->
  <div class="tool-card active" data-nama="momentum impuls massa kecepatan">
    <h2>15 // MOMENTUM (p = m · v)</h2>
    <div class="input-group"><label>Massa (m) [kg]</label><input type="number" id="mom-m"></div>
    <div class="input-group"><label>Kecepatan (v) [m/s]</label><input type="number" id="mom-v"></div>
    <button class="hitung" onclick="hitungMom()">HITUNG</button>
    <div class="hasil" id="out-mom">> Standby...</div>
  </div>

</div>

<script>
  // Fitur Pencarian
  function cariRumus() {
    let input = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('.tool-card').forEach(card => {
      let nama = card.getAttribute('data-nama').toLowerCase();
      let judul = card.querySelector('h2').innerText.toLowerCase();
      if(nama.includes(input) || judul.includes(input)) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function val(id) { const x = parseFloat(document.getElementById(id).value); return isNaN(x) ? null : x; }
  function show(id, text, isErr = false) {
    const el = document.getElementById(id);
    el.innerHTML = "> " + text;
    el.className = isErr ? "hasil error" : "hasil";
  }

  function hitungV() {
    let s = val('v-s'), t = val('v-t');
    if(s===null || t===null || t===0) return show('out-v', 'INVALID (t≠0)!', true);
    show('out-v', `v = ${(s/t).toFixed(2)} m/s`);
  }
  function hitungA() {
    let v = val('a-v'), v0 = val('a-v0'), t = val('a-t');
    if(v===null || v0===null || t===null || t===0) return show('out-a', 'INVALID (t≠0)!', true);
    show('out-a', `a = ${((v-v0)/t).toFixed(2)} m/s²`);
  }
  function hitungF() {
    let m = val('f-m'), a = val('f-a');
    if(m===null || a===null) return show('out-f', 'INVALID INPUT!', true);
    show('out-f', `F = ${(m*a).toFixed(2)} Newton`);
  }
  function hitungEk() {
    let m = val('ek-m'), v = val('ek-v');
    if(m===null || v===null) return show('out-ek', 'INVALID INPUT!', true);
    show('out-ek', `Ek = ${(0.5*m*v*v).toFixed(2)} Joule`);
  }
  function hitungEp() {
    let m = val('ep-m'), g = val('ep-g'), h = val('ep-h');
    if(m===null || g===null || h===null) return show('out-ep', 'INVALID INPUT!', true);
    show('out-ep', `Ep = ${(m*g*h).toFixed(2)} Joule`);
  }
  function hitungW() {
    let f = val('w-f'), s = val('w-s');
    if(f===null || s===null) return show('out-w', 'INVALID INPUT!', true);
    show('out-w', `W = ${(f*s).toFixed(2)} Joule`);
  }
  function hitungP() {
    let w = val('p-w'), t = val('p-t');
    if(w===null || t===null || t===0) return show('out-p', 'INVALID (t≠0)!', true);
    show('out-p', `P = ${(w/t).toFixed(2)} Watt`);
  }
  function hitungPr() {
    let f = val('pr-f'), a = val('pr-a');
    if(f===null || a===null || a===0) return show('out-pr', 'INVALID (A≠0)!', true);
    show('out-pr', `P = ${(f/a).toFixed(2)} Pascal`);
  }
  function hitungRho() {
    let m = val('rho-m'), v = val('rho-v');
    if(m===null || v===null || v===0) return show('out-rho', 'INVALID (V≠0)!', true);
    show('out-rho', `ρ = ${(m/v).toFixed(2)} kg/m³`);
  }
  function konversiSuhu() {
    let c = val('suhu-c');
    if(c===null) return show('out-suhu', 'INVALID INPUT!', true);
    show('out-suhu', `F: ${((c*9/5)+32).toFixed(1)}°F | K: ${(c+273.15).toFixed(2)}K`);
  }
  function hitungQ() {
    let m = val('q-m'), c = val('q-c'), dt = val('q-dt');
    if(m===null || c===null || dt===null) return show('out-q', 'INVALID INPUT!', true);
    show('out-q', `Q = ${(m*c*dt).toFixed(2)} Joule`);
  }
  function hitungOhm() {
    let i = val('ohm-i'), r = val('ohm-r');
    if(i===null || r===null) return show('out-ohm', 'INVALID INPUT!', true);
    show('out-ohm', `V = ${(i*r).toFixed(2)} Volt`);
  }
  function hitungPl() {
    let v = val('pl-v'), i = val('pl-i');
    if(v===null || i===null) return show('out-pl', 'INVALID INPUT!', true);
    show('out-pl', `P = ${(v*i).toFixed(2)} Watt`);
  }
  function hitungGel() {
    let l = val('gel-l'), f = val('gel-f');
    if(l===null || f===null) return show('out-gel', 'INVALID INPUT!', true);
    show('out-gel', `v = ${(l*f).toFixed(2)} m/s`);
  }
  function hitungMom() {
    let m = val('mom-m'), v = val('mom-v');
    if(m===null || v===null) return show('out-mom', 'INVALID INPUT!', true);
    show('out-mom', `p = ${(m*v).toFixed(2)} kg·m/s`);
  }
</script>
</body>
</html>
